rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Lettura libera (intranet: chi ha il link vede i contenuti).
    // Scrittura solo da chi ha aperto la pagina (login anonimo automatico) —
    // impedisce a bot/scraper esterni di scrivere direttamente sull'API,
    // ma non e' una vera autenticazione per persona: il gate a password
    // nella pagina resta solo un filtro visivo, non di sicurezza.
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
